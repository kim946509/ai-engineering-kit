{
  "name": "code-review-graph",
  "version": 1,
  "status": "experimental",
  "summary": "Keep a local code graph fresh and maintain repository-backed AGENTS.md guidance on a slower schedule.",
  "requires": {
    "git_repository": true,
    "commands": [
      "code-review-graph"
    ]
  },
  "runtime_state": ".code-review-graph/",
  "update_modes": [
    "post-tool-use-hook",
    "watch"
  ],
  "mutually_exclusive_update_modes": true,
  "agents": {
    "codex": "experimental",
    "claude-code": "planned",
    "cursor": "planned"
  }
}
